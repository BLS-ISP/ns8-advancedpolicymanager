#!/usr/bin/env python3

import os
import subprocess
import agent

app_image = os.environ.get("ADVANCEDPOLICYMANAGER_APP_IMAGE", "").strip()
if app_image:
    pull_res = subprocess.run(["podman", "pull", app_image], check=False)
    agent.assert_exp(pull_res.returncode == 0)

is_active = subprocess.run(
    ["systemctl", "--user", "-q", "is-active", "advancedpolicymanager.service"],
    check=False,
).returncode == 0

if is_active:
    subprocess.run(
        ["systemctl", "--user", "restart", "advancedpolicymanager.service"],
        check=True,
    )
