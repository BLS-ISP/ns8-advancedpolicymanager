#!/usr/bin/env python3

import os
import subprocess
import agent

# Stop and disable systemd user service
subprocess.run(
    ["systemctl", "--user", "disable", "--now", "advancedpolicymanager.service"],
    check=False,
)

# Delete Traefik HTTP route if present
default_traefik_id = agent.resolve_agent_id("traefik@node")
if default_traefik_id is not None and os.environ.get("MODULE_ID"):
    response = agent.tasks.run(
        agent_id=default_traefik_id,
        action="delete-route",
        data={"instance": os.environ["MODULE_ID"]},
    )
    agent.assert_exp(response["exit_code"] == 0)

# Unbind all NS8 user domains
agent.bind_user_domains([])

# Clean up persistent Podman volume
subprocess.run(["podman", "volume", "rm", "-f", "apm-data"], check=False)
