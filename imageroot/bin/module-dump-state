#!/usr/bin/env python3

import os
import subprocess
from pathlib import Path

CONTAINER_NAME = "advancedpolicymanager-app"
BACKUP_PATH = Path(os.environ.get("APM_STATE_BACKUP_FILE", "apm.db.bak"))

inspect_res = subprocess.run(
    ["podman", "inspect", "-f", "{{.State.Running}}", CONTAINER_NAME],
    capture_output=True,
    text=True,
    check=False,
)

if inspect_res.returncode == 0 and inspect_res.stdout.strip().lower() == "true":
    python_snippet = (
        "import os, sqlite3; "
        "db_path = '/data/apm.db'; "
        "tmp_bak = '/data/.apm.db.bak'; "
        "src = sqlite3.connect(db_path) if os.path.exists(db_path) else None; "
        "dst = sqlite3.connect(tmp_bak) if src else None; "
        "src.backup(dst) if (src and dst) else None; "
        "dst.close() if dst else None; "
        "src.close() if src else None"
    )
    subprocess.run(
        ["podman", "exec", CONTAINER_NAME, "python3", "-c", python_snippet],
        check=True,
    )
    exists_res = subprocess.run(
        ["podman", "exec", CONTAINER_NAME, "test", "-f", "/data/.apm.db.bak"],
        check=False,
    )
    if exists_res.returncode == 0:
        BACKUP_PATH.parent.mkdir(parents=True, exist_ok=True)
        subprocess.run(
            ["podman", "cp", f"{CONTAINER_NAME}:/data/.apm.db.bak", str(BACKUP_PATH)],
            check=True,
        )
        subprocess.run(
            ["podman", "exec", CONTAINER_NAME, "rm", "-f", "/data/.apm.db.bak"],
            check=False,
        )
